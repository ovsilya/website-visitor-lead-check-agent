# Copy to lead_agent/.env (never commit .env)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Required: the app won't start without it.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
MODEL=gemini-3.5-flash


# Send person names of new target-account Tier 1-2 leads to the model? Keep false
# until real RB2B data on this project is cleared.
SHARE_NAMES_WITH_MODEL=false

# Local only: ADK's developer UI at /dev-ui/ (events, traces). Never on Cloud Run.
# ADK_DEV_UI=1
